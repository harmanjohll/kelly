---
import { url } from '../lib/url';
import ProductCard from './ProductCard.astro';
import type { Product } from '../lib/types';
interface Props { title: string; intro: string; items: Product[]; facts: string[] }
const { title, intro, items, facts } = Astro.props;
---
<section class="wrap col-head">
  <h1><em>{title}</em></h1>
  <p class="intro">{intro}</p>
  <ul class="facts small muted">{facts.map((f) => <li>{f}</li>)}</ul>
</section>
<section class="wrap grid" aria-label={`${title} pieces`}>
  {items.map((p, i) => <ProductCard product={p} wide={i === 0} />)}
</section>
<section class="wrap unsure">
  <p>Not sure which? <a href={url('/consult/')}>Help me choose</a></p>
</section>
<style>
  .col-head { padding-top: clamp(2rem, 6vw, 4.5rem); padding-bottom: clamp(2rem, 5vw, 3.5rem); display: grid; gap: 1rem; }
  .intro { font-size: 1.15rem; color: var(--ink-2); max-width: 46ch; margin: 0; }
  .facts { list-style: none; padding: 0; margin: 0.5rem 0 0; display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; }
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(1.5rem, 3vw, 2.5rem) clamp(1rem, 2.5vw, 2rem); }
  .unsure { margin-top: 3.5rem; font-family: var(--serif); font-size: 1.6rem; }
  @media (max-width: 960px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .grid { grid-template-columns: 1fr; } }
</style>
