---
import Art from './Art.astro';
import type { Product } from '../lib/types';
interface Props { product: Product; wide?: boolean }
const { product, wide = false } = Astro.props;
const lineLabel = { fresh: 'Fresh', forever: 'Crochet', stays: 'Fresh with one crochet bloom', bespoke: 'Bespoke' }[product.line];
---
<a class:list={['card reveal', { wide }]} href={`/pieces/${product.slug}/`}>
  <Art product={product} />
  <div class="meta">
    <h3>{product.name}</h3>
    <p class="line small muted">{lineLabel}</p>
    <p class="sum">{product.summary}</p>
    <p class="small muted">{product.priceFrom ? `From S$${product.priceFrom}` : 'Price on request'}</p>
  </div>
</a>
<style>
  .card { display: grid; gap: 1rem; align-self: start; align-content: start; text-decoration: none; color: inherit; }
  .card:hover h3 { color: var(--accent); }
  .card:hover :global(.art-frame) { background: color-mix(in srgb, var(--paper-2) 80%, var(--bloom-blush)); }
  .meta h3 { margin-bottom: 0.2rem; transition: color 0.2s ease; }
  .line { margin-bottom: 0.5rem; }
  .sum { margin-bottom: 0.4rem; }
  .wide { grid-column: span 2; grid-template-columns: 1.1fr 1fr; align-items: center; gap: 2rem; }
  @media (max-width: 760px) { .wide { grid-column: auto; grid-template-columns: 1fr; gap: 1rem; } }
</style>
