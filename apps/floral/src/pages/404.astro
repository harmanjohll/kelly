---
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';
---
<Base title="Page not found">
  <section class="wrap lost">
    <h1>This page has wilted.</h1>
    <p>The link may be old, or the piece may no longer be made.</p>
    <p><a class="btn" href={url('/')}>Back to the start</a></p>
  </section>
</Base>
<style>
  .lost { padding-top: clamp(3rem, 10vw, 7rem); display: grid; gap: 1rem; justify-items: start; }
  .lost p { color: var(--ink-2); font-size: 1.15rem; }
</style>
