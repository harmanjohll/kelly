---
import { artFor } from '../lib/bloom';
import type { Product } from '../lib/types';
interface Props { product: Pick<Product, 'line' | 'art' | 'name'>; class?: string }
const { product, class: cls } = Astro.props;
---
<figure class:list={['art-frame', cls]}>
  <Fragment set:html={artFor(product)} />
</figure>
<style>
  .art-frame { margin: 0; background: var(--paper-2); border-radius: var(--edge); aspect-ratio: 8 / 9; display: grid; place-items: center; padding: 6% 8% 2%; }
  .art-frame :global(svg) { width: 100%; height: 100%; }
</style>
