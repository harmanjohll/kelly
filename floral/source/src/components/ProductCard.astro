---
import { url } from '../lib/url';
import { posterMarkup } from '../lib/poster';
import type { Product } from '../lib/types';
interface Props { product: Product; wide?: boolean }
const { product, wide = false } = Astro.props;
---
<a class:list={['card reveal', { wide }]} href={url(`/pieces/${product.slug}/`)}>
  <Fragment set:html={posterMarkup(product, { base: import.meta.env.BASE_URL, size: wide ? 'lg' : 'sm' })} />
  <span class="meta">
    <span class="sum">{product.summary}</span>
    <span class="price">{product.priceFrom ? `From S$${product.priceFrom}` : 'Price on request'}</span>
  </span>
</a>
<style>
  .card { display: grid; gap: 0.9rem; align-content: start; text-decoration: none; color: inherit; }
  .card :global(.poster) { transition: transform 0.35s var(--ease); }
  .card:hover :global(.poster) { transform: rotate(-1.2deg); }
  .card:hover :global(.p-name) { font-stretch: 95%; }
  .card :global(.p-name) { transition: font-stretch 0.35s var(--ease); }
  .meta { display: grid; gap: 0.3rem; }
  .sum { max-width: 46ch; }
  .price { font-family: var(--display); font-weight: 650; font-stretch: 105%; font-size: 0.95rem; }
  .wide { grid-column: span 2; }
  .wide :global(.poster) { aspect-ratio: 16 / 10; }
  @media (max-width: 760px) { .wide { grid-column: auto; } }
</style>
