---
// FLEETING, set so it wilts: letters narrow, thin and droop one by one, like stems over a week.
// It is a button: tapping "waters" the word and the letters spring back upright.
interface Props { word: string; tag?: 'h1' | 'h2' | 'div'; class?: string }
const { word, tag = 'h1', class: cls } = Astro.props;
const Tag = tag;
// Each letter droops by its own amount, alternating sides, so the word wilts unevenly like a real bunch.
const droops = [7, -5, 10, -8, 4, -11, 8, -6, 9, -4, 12, -7];
const letters = [...word].map((ch, i) => ({ ch, droop: droops[i % droops.length], i }));
---
<Tag class:list={['wilt-word', cls]}>
  <button type="button" class="wilt" aria-label={`${word}. Tap to water the flowers.`}>
    <span class="letters" aria-hidden="true">
      {letters.map((l) => <span class="l" style={`--i:${l.i};--droop:${l.droop}deg`}>{l.ch}</span>)}
    </span>
  </button>
  <span class="water-hint small" aria-hidden="true">Tap to water</span>
</Tag>

<style>
  .wilt-word { margin: 0; position: relative; line-height: 0.86; font-size: inherit; }
  .wilt { all: unset; cursor: pointer; display: block; touch-action: manipulation; -webkit-tap-highlight-color: transparent; }
  .wilt:focus-visible { outline: 3px solid currentColor; outline-offset: 6px; }
  .letters { display: block; white-space: nowrap; }
  .l {
    display: inline-block; text-align: left; vertical-align: bottom;
    font-family: var(--display); font-weight: 820; font-stretch: 122%;
    text-transform: uppercase; letter-spacing: -0.01em;
    transform-origin: 30% 100%;
  }
  .water-hint {
    position: absolute; right: 0; bottom: -1.6rem; font-family: var(--text); font-weight: 500; line-height: 1;
    opacity: 0; transition: opacity 0.6s ease; pointer-events: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Widths are pinned by script before the wilt starts, so nothing around the word shifts. */
    .wilt-word.go .l { animation: wilt calc(5.5s * var(--tempo)) cubic-bezier(0.45, 0, 0.7, 1) forwards; animation-delay: calc((1.2s + var(--i) * 0.55s) * var(--tempo)); }
    .wilt-word.go.wilted .water-hint { opacity: 0.75; }
    .wilt-word.water .l { animation: water 0.65s var(--spring) both; animation-delay: calc(var(--i) * 25ms); }
  }
  @keyframes wilt {
    0% { font-stretch: 122%; font-weight: 820; transform: none; opacity: 1; }
    55% { opacity: 0.9; }
    100% { font-stretch: 58%; font-weight: 260; transform: translateY(0.07em) rotate(var(--droop)); opacity: 0.55; }
  }
  @keyframes water {
    0% { transform: translateY(0.12em) scaleY(0.85); }
    100% { transform: none; }
  }
  /* Reduced motion: the word rests half wilted, so the idea still reads. */
  @media (prefers-reduced-motion: reduce) {
    .l:nth-child(n + 4) { font-stretch: 78%; font-weight: 480; opacity: 0.75; transform: translateY(0.03em) rotate(calc(var(--droop) * 0.5)); }
  }
</style>

<script>
  for (const word of document.querySelectorAll<HTMLElement>('.wilt-word')) {
    const letters = [...word.querySelectorAll<HTMLElement>('.l')];
    const pin = () => {
      word.classList.remove('go', 'wilted');
      letters.forEach((l) => (l.style.width = ''));
      letters.forEach((l) => (l.style.width = `${l.getBoundingClientRect().width}px`));
      word.classList.add('go');
    };
    const last = letters[letters.length - 1];
    last?.addEventListener('animationend', (e) => { if (e.animationName === 'wilt') word.classList.add('wilted'); });
    word.querySelector('.wilt')?.addEventListener('click', () => {
      word.classList.remove('go', 'wilted');
      word.classList.add('water');
      setTimeout(() => { word.classList.remove('water'); word.classList.add('go'); }, 900);
    });
    document.fonts.ready.then(pin);
    let t: number | undefined;
    addEventListener('resize', () => { clearTimeout(t); t = window.setTimeout(pin, 200); });
  }
</script>
