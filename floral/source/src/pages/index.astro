---
import { url } from '../lib/url';
import Base from '../layouts/Base.astro';
import WiltWord from '../components/WiltWord.astro';
import StitchWord from '../components/StitchWord.astro';
import { intentions } from '../lib/coach';

// Eight fresh stems that fade as you scroll, and the one that stays.
const stems = ['garden rose', 'ranunculus', 'lisianthus', 'spray rose', 'eucalyptus', 'chamomile', 'tulip', 'statice'];
---
<Base>
  <section class="hero wrap" aria-labelledby="hero-h">
    <h1 id="hero-h" class="sr-only">Kelly: fresh flowers for the week, crochet flowers to keep</h1>
    <div class="pair">
      <WiltWord word="Fleeting" tag="div" class="big" />
      <p class="gloss"><span>Fresh flowers. A week of colour, then gone.</span> <a class="arrow-link" href={url('/fleeting/')}>Fresh pieces</a></p>
    </div>
    <div class="pair">
      <StitchWord word="Forever" tag="div" class="big" />
      <p class="gloss"><span>Crochet flowers. Made by hand, kept for years.</span> <a class="arrow-link" href={url('/forever/')}>Crochet pieces</a></p>
    </div>
    <div class="hero-foot">
      <p class="lede">Not sure which? Tell me who they're for and I'll help you choose.</p>
      <a class="btn" href={url('/consult/')}>Help me choose</a>
    </div>
  </section>

  <section class="say" aria-labelledby="say-h">
    <h2 id="say-h" class="wrap say-h">What do you want to say?</h2>
    <ul class="bars">
      {intentions.map((i) => (
        <li style={`--c:${i.color};--ci:${i.ink}`}>
          <a href={url(`/consult/?say=${i.id}`)} aria-describedby={`hint-${i.id}`}>
            <span class="wrap bar">
              <span class="bar-say">{i.say}</span>
              <span class="bar-hint" id={`hint-${i.id}`} aria-hidden="true">{i.hint}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="stays wrap" aria-labelledby="stays-h">
    <p class="stem-row" aria-hidden="true">
      {stems.map((s, i) => <span class="stem" style={`--n:${i}`}>{s}</span>)}
      <span class="stem keep">and one crochet rose</span>
    </p>
    <div class="stays-text">
      <h2 id="stays-h">One stays.</h2>
      <p>A fresh bouquet with one crocheted bloom tucked inside. When the fresh flowers fade, one remains.</p>
      <a class="arrow-link" href={url('/pieces/the-one-that-stays/')}>The One That Stays</a>
    </div>
  </section>

  <section class="care wrap" aria-labelledby="care-h">
    <h2 id="care-h">Careful with meaning.</h2>
    <div class="posters">
      <article class="cp cp-four">
        <p class="cp-big" aria-hidden="true"><span class="slash">4</span></p>
        <p>Never four stems for a Chinese family. Four (四) sounds like the word for death.</p>
      </article>
      <article class="cp cp-cats">
        <p class="cp-big" aria-hidden="true">Lilies <span class="op">×</span> cats</p>
        <p>Lily pollen is toxic to cats. The consultation asks before it suggests.</p>
      </article>
      <article class="cp cp-white">
        <p class="cp-big" aria-hidden="true">White <span class="op">≠</span> birthday</p>
        <p>White chrysanthemums are kept for mourning, never for a celebration.</p>
      </article>
    </div>
    <p><a class="arrow-link" href={url('/meanings/')}>How flowers are read across Singapore's traditions</a></p>
  </section>

  <section class="maker wrap" aria-labelledby="maker-h">
    <div class="photo-slot maker-photo">Kelly's portrait, at work. Arriving soon.</div>
    <div class="maker-text">
      <h2 id="maker-h">Made by Kelly.</h2>
      <p>Every bouquet is tied by hand and every crochet bloom is worked stitch by stitch, by one person, here in Singapore.</p>
      <a class="arrow-link" href={url('/kelly/')}>Kelly's story</a>
    </div>
  </section>
</Base>

<style>
  /* Hero: the two words are the page. */
  .hero { padding-top: clamp(1.5rem, 4vw, 3.5rem); display: grid; gap: clamp(1.5rem, 3vw, 2.5rem); }
  .pair { display: grid; gap: 0.6rem; }
  .hero :global(.big) { font-size: clamp(2.6rem, 15vw, 15rem); }
  .gloss { display: flex; flex-wrap: wrap; gap: 0.4rem 1.25rem; align-items: baseline; margin: 0; max-width: none; font-size: 1.05rem; }
  .gloss span { color: var(--ink-2); }
  .hero-foot { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem 2rem; border-top: 2px solid var(--ink); padding-top: 1.25rem; }
  .lede { margin: 0; font-family: var(--voice); font-style: italic; font-size: clamp(1.3rem, 2.4vw, 1.8rem); line-height: 1.25; max-width: 30ch; }

  /* Intentions as colour fields. */
  .say { margin-top: clamp(5rem, 11vw, 9rem); }
  .say-h { margin-bottom: 1.75rem; }
  .bars { list-style: none; margin: 0; padding: 0; }
  .bars li { background: var(--c); color: var(--ci); }
  .bars a { display: block; text-decoration: none; color: inherit; }
  .bar { display: flex; align-items: baseline; justify-content: space-between; gap: 1.5rem; padding-top: 0.55rem; padding-bottom: 0.55rem; }
  .bar-say {
    font-family: var(--display); font-weight: 780; font-stretch: 80%; text-transform: uppercase;
    font-size: clamp(2rem, 6.4vw, 5.6rem); line-height: 0.95; letter-spacing: -0.01em;
    transition: font-stretch 0.35s var(--ease);
  }
  .bar-hint { font-size: 1rem; max-width: 28ch; text-align: right; }
  .bars a:hover .bar-say, .bars a:focus-visible .bar-say { font-stretch: 130%; }
  .bars a:focus-visible { outline: 4px solid var(--ci); outline-offset: -6px; }

  /* One stays: fresh stems fade as you scroll past; the crochet rose does not. */
  .stays { margin-top: clamp(5rem, 11vw, 9rem); display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); gap: clamp(2rem, 5vw, 5rem); align-items: end; }
  .stem-row { margin: 0; max-width: none; font-family: var(--display); font-weight: 760; font-stretch: 75%; text-transform: uppercase; font-size: clamp(2rem, 5vw, 4.4rem); line-height: 0.98; }
  .stem { display: inline-block; margin-right: 0.28em; opacity: calc(1 - var(--n) * 0.1); }
  .keep { opacity: 1; font-stretch: 118%; font-weight: 860; text-decoration: underline dashed 0.06em; text-underline-offset: 0.14em; }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .stem:not(.keep) { opacity: 1; animation: fade linear both; animation-timeline: view(); animation-range: calc(30% + var(--n) * 4%) calc(45% + var(--n) * 4%); }
      @keyframes fade { to { opacity: 0.08; } }
    }
  }
  .stays-text h2 { margin-bottom: 1rem; }

  /* Careful with meaning: three posters, three sizes. */
  .care { margin-top: clamp(5rem, 11vw, 9rem); }
  .care h2 { margin-bottom: 1.75rem; }
  .posters { display: grid; grid-template-columns: 1.3fr 1fr; grid-template-rows: auto auto; gap: 2px; background: var(--ink); border: 2px solid var(--ink); margin-bottom: 1.5rem; }
  .cp { padding: clamp(1.25rem, 3vw, 2.25rem); background: var(--paper); display: grid; align-content: space-between; gap: 1.25rem; }
  .cp p:last-child { margin: 0; }
  .cp-four { grid-row: span 2; background: var(--ink); color: var(--paper); }
  .cp-big { margin: 0; font-family: var(--display); font-weight: 820; text-transform: uppercase; line-height: 0.9; font-stretch: 80%; font-size: clamp(2.4rem, 6vw, 5rem); }
  .cp-four .cp-big { font-size: clamp(9rem, 30vw, 22rem); font-stretch: 120%; line-height: 0.8; }
  .slash { position: relative; display: inline-block; }
  .slash::after { content: ''; position: absolute; left: -12%; right: -12%; top: 50%; height: 0.075em; background: #e8452c; transform: rotate(-38deg); }
  .cp-big .op { font-stretch: 50%; font-weight: 400; }
  .cp-white { background: var(--paper-2); }

  /* Maker */
  .maker { margin-top: clamp(5rem, 11vw, 9rem); display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1fr); gap: clamp(1.5rem, 5vw, 5rem); align-items: end; }
  .maker-photo { aspect-ratio: 1 / 1; max-height: 460px; }
  .maker-text h2 { margin-bottom: 1rem; }

  @media (max-width: 860px) {
    .bar { flex-direction: column; gap: 0.15rem; }
    .bar-hint { text-align: left; font-size: 0.9rem; }
    .stays, .maker { grid-template-columns: 1fr; }
    .posters { grid-template-columns: 1fr; }
    .cp-four { grid-row: auto; }
    .maker-photo { aspect-ratio: 4 / 3; }
  }
</style>
